{
  "productName": "LIVE",
  "identifier": "cn.live.localbuild",
  "build": {
    "beforeBuildCommand": "corepack yarn build"
  },
  "bundle": {
    "active": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "live-local"
        ]
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LIVE",
        "width": 1300,
        "height": 700,
        "resizable": true,
        "theme": "Dark"
      }
    ]
  }
}
