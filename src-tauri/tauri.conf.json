{
  "build": {
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8054"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "resources": [],
    "macOS": {
      "minimumSystemVersion": "13.3"
    }
  },
  "productName": "LIVE",
  "version": "../package.json",
  "identifier": "cn.live",
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:data_v2.db"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "live"
        ]
      }
    }
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "assetProtocol": {
        "scope": [
          "**"
        ],
        "enable": true
      },
      "csp": null
    }
  },
  "mainBinaryName": "LIVE"
}
